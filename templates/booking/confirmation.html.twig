{% extends 'layout.html.twig' %}

{% block title %}Booking Confirmation #{{ booking.id }}{% endblock %}

{% block content %}
  <section class="max-w-4xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-12">
      <h1 class="text-3xl font-bold text-gray-900">
        ✅ Thanks for your booking!
        <span class="text-gray-400 text-base font-normal block sm:inline">
          #{{ booking.id }}
        </span>
      </h1>
      <a href="{{ path('app_my_tickets') }}" class="btn-primary">
        Go to my tickets
      </a>
    </div>

    <hr class="border-gray-200 mb-12">

    <!-- Event Name -->
    <div class="text-center mb-12">
      <p class="text-sm uppercase tracking-wide text-gray-500 mb-2">You're going to</p>
      <h2 class="text-xl md:text-2xl font-bold text-gray-900">{{ booking.tickets.first.category.event.name }}</h2>
    </div>

    <!-- Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
      <!-- Email -->
      <div class="text-center p-6 bg-white rounded-xl border border-gray-200 shadow-xs">
        <p class="text-xs uppercase tracking-wide text-gray-500 mb-2">Confirmation sent to</p>
        <p class="text-sm font-medium text-gray-900 break-all">{{ booking.user.email }}</p>
      </div>
      
      <!-- Date -->
      <div class="text-center p-6 bg-white rounded-xl border border-gray-200 shadow-xs">
        <p class="text-xs uppercase tracking-wide text-gray-500 mb-2">Date</p>
        <p class="text-sm font-medium text-gray-900">{{ booking.tickets.first.category.event.startAt|date('l, F j, Y') }}</p>
        <p class="text-xs text-gray-500 mt-1">{{ booking.tickets.first.category.event.startAt|date('g:i A') }}</p>
      </div>
      
      <!-- Location -->
      <div class="text-center p-6 bg-white rounded-xl border border-gray-200 shadow-xs">
        <p class="text-xs uppercase tracking-wide text-gray-500 mb-2">Location</p>
        <p class="text-sm font-medium text-gray-900">{{ booking.tickets.first.category.event.location }}</p>
      </div>
    </div>
  </section>
{% endblock %}