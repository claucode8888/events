{% extends 'layout.html.twig' %}

{% block title %}Booking #{{ booking.id }}{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto p-6">
  {# Header #}
  <div class="text-center mb-8">
    <h1 class="text-2xl font-bold mb-2">✅ Booking Confirmed</h1>
    <p class="text-gray-600">Booking ID: <strong>#{{ booking.id }}</strong> • {{ booking.createdAt|date('M j, Y g:i A') }}</p>
  </div>

  {# Email notice #}
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
    <div class="flex items-center">
      <svg class="w-5 h-5 text-blue-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      <div>
        <p class="font-medium text-blue-800">Confirmation sent to your email</p>
        <p class="text-sm text-blue-700">You can also download a PDF copy below</p>
      </div>
    </div>
  </div>

  {# Tickets #}
  <div class="bg-white border rounded-lg p-6 mb-6">
    <h2 class="text-lg font-bold mb-4">Your Tickets ({{ booking.tickets|length }})</h2>
    {% for ticket in booking.tickets %}
      <div class="border-b py-3 last:border-b-0">
        <div class="flex justify-between items-center">
          <div>
            <div class="font-medium">{{ ticket.category.name }}</div>
            <div class="text-sm text-gray-500">{{ ticket.category.event.name }}</div>
          </div>
          <div class="text-right">
            <div class="font-bold">€{{ ticket.category.price|number_format(2) }}</div>
            <a href="{{ path('app_ticket_details', {id: ticket.id}) }}"
              class="text-xs text-blue-600 hover:text-blue-800 hover:underline">
              View Individual Ticket
            </a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {# Event Info #}
  {% if booking.tickets|length > 0 %}
    {% set event = booking.tickets.first.category.event %}
    <div class="bg-white border rounded-lg p-6 mb-6">
      <h2 class="text-lg font-bold mb-4">Event Info</h2>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <div class="text-sm text-gray-500">Event</div>
          <div class="font-medium">{{ event.name }}</div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Date</div>
          <div class="font-medium">{{ event.startAt|date('M j, Y') }}</div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Time</div>
          <div class="font-medium">{{ event.startAt|date('g:i A') }}</div>
        </div>
        <div>
          <div class="text-sm text-gray-500">Status</div>
          <div class="font-medium">{{ booking.status|upper }}</div>
        </div>
      </div>
    </div>
  {% endif %}

  {# Total #}
  <div class="bg-white border rounded-lg p-6 mb-6">
    <h2 class="text-lg font-bold mb-4">Payment Summary</h2>
    <div class="space-y-2">
      <div class="flex justify-between">
        <span>Tickets</span>
        <span>€{{ booking.total|number_format(2) }}</span>
      </div>
      <div class="flex justify-between">
        <span>Service Fee</span>
        <span>€0.00</span>
      </div>
      <hr class="my-2">
      <div class="flex justify-between text-lg font-bold">
        <span>Total</span>
        <span>€{{ booking.total|number_format(2) }}</span>
      </div>
    </div>
  </div>

  {# QR Codes #}
  <div class="bg-white border rounded-lg p-6 mb-6">
    <h2 class="text-lg font-bold mb-4">Ticket QR Codes</h2>
    <div class="grid grid-cols-2 gap-4">
      {% for ticket in booking.tickets %}
        {% include 'ticket/_qr.html.twig' with {qrtoken: ticket.qrtoken} %}
      {% endfor %}
    </div>
  </div>
  
  {# Actions #}
  <div class="grid grid-cols-3 gap-3">
    {# Download PDF #}
    <a href="{{ path('app_booking_pdf', { id: booking.id }) }}"
      class="flex flex-col items-center justify-center gap-1 bg-blue-900 hover:bg-blue-700 text-white py-3 rounded font-medium cursor-pointer transition duration-200"
      title="Download Tickets"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      <span class="text-xs">Download PDF</span>
    </a>

    {# Event Page #}
    <a href="{{ path('app_event_details', { id: event.id }) }}"
      class="flex flex-col items-center justify-center gap-1 bg-blue-900 hover:bg-blue-700 text-white py-3 rounded font-medium cursor-pointer transition duration-200"
      title="Event Page"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span class="text-xs">Event Page</span>
    </a>

    {# My Tickets #}
    <a href="{{ path('app_my_tickets') }}"
      class="flex flex-col items-center justify-center gap-1 bg-blue-900 hover:bg-blue-700 text-white py-3 rounded font-medium cursor-pointer transition duration-200"
      title="See My Tickets"
    >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />
    </svg>
      <span class="text-xs">My Tickets</span>
    </a>
  </div>
</div>
{% endblock %}