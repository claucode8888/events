{% extends 'layout.html.twig' %}

{% block title %}Payment Successful - EventHub{% endblock %}

{% block content %}
  <div class="max-w-2xl mx-auto text-center py-16 px-4">
    <div class="text-green-500 text-6xl mb-6">✓</div>
    <h1 class="text-3xl font-bold mb-4">Payment Successful!</h1>
    <p class="text-gray-400 mb-8">Your booking has been confirmed. You'll receive a confirmation email shortly.</p>
    <div class="flex gap-4 justify-center">
      <a href="{{ path('app_my_tickets') }}" class="btn-primary">
        Go to My Tickets
      </a>
      <a href="{{ path('app_event_index') }}" class="btn-primary">
        Browse Events
      </a>
    </div>
  </div>
{% endblock %}