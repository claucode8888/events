<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Confirmation</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f3f4f6;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .content {
            padding: 32px 24px;
        }
        .text-center { text-align: center; }
        .mb-2 { margin-bottom: 8px; }
        .mb-4 { margin-bottom: 16px; }
        .mb-6 { margin-bottom: 24px; }
        .mt-2 { margin-top: 8px; }
        .mt-4 { margin-top: 16px; }
        .text-gray-500 { color: #6b7280; }
        .text-gray-600 { color: #4b5563; }
        .text-gray-900 { color: #111827; }
        .text-blue-600 { color: #2563eb; }
        .font-bold { font-weight: 700; }
        .font-semibold { font-weight: 600; }
        .text-sm { font-size: 14px; }
        .text-lg { font-size: 18px; }
        .text-xl { font-size: 20px; }
        .text-2xl { font-size: 24px; }
        .border-t { border-top: 1px solid #e5e7eb; }
        .border-b { border-bottom: 1px solid #e5e7eb; }
        .py-3 { padding-top: 12px; padding-bottom: 12px; }
        .py-4 { padding-top: 16px; padding-bottom: 16px; }
        .rounded-lg { border-radius: 12px; }
        .w-full { width: 100%; }
        .h-auto { height: auto; }
        .flex { display: flex; }
        .justify-between { justify-content: space-between; }
        .gap-4 { gap: 16px; }
    </style>
</head>
<body>
    <div class="container">
        <!-- Event Image -->
        {% if event.imgPath %}
            <img src="{{ absolute_url(asset(uploads_events ~ '/' ~ event.imgPath)) }}" 
                 alt="{{ event.name }}" 
                 class="w-full h-auto" 
                 style="width: 100%; height: auto; display: block;">
        {% endif %}
        
        <!-- Content -->
        <div class="content">
            <!-- Header -->
            <div class="text-center mb-6">
                <div style="font-size: 32px;">🎉</div>
                <h1 class="text-2xl font-bold text-gray-900 mb-2" style="margin: 8px 0 0 0;">Booking Confirmed!</h1>
                <p class="text-sm text-gray-500" style="margin: 4px 0 0 0;">Booking #{{ booking.id }}</p>
            </div>
            
            <!-- Event Name -->
            <div class="text-center mb-6">
                <h2 class="text-xl font-bold text-gray-900" style="margin: 0;">{{ event.name }}</h2>
            </div>
            
            <!-- Event Details -->
            <div class="border-t border-b py-4 mb-6">
                <div class="flex justify-between mb-3">
                    <span class="text-sm text-gray-500">Date</span>
                    <span class="text-sm font-semibold text-gray-900">{{ event.startAt|date('l, F j, Y') }}</span>
                </div>
                <div class="flex justify-between mb-3">
                    <span class="text-sm text-gray-500">Time</span>
                    <span class="text-sm font-semibold text-gray-900">{{ event.startAt|date('g:i A') }} - {{ event.endAt|date('g:i A') }}</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-gray-500">Location</span>
                    <span class="text-sm font-semibold text-gray-900">{{ event.location }}</span>
                </div>
            </div>
            
            <!-- Tickets Summary -->
            <div class="mb-6">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Your Tickets</h3>
                
                {% for category in tickets_by_category %}
                    <div class="flex justify-between py-2">
                        <div>
                            <span class="text-sm text-gray-900">{{ category.name }}</span>
                            <span class="text-sm text-gray-500"> x{{ category.category_total_tickets }}</span>
                        </div>
                        <span class="text-sm font-semibold text-gray-900">€{{ category.total_price|number_format(2) }}</span>
                    </div>
                {% endfor %}
                
                <div class="border-t mt-4 pt-4">
                    <div class="flex justify-between">
                        <span class="text-sm text-gray-500">Subtotal</span>
                        <span class="text-sm text-gray-900">€{{ booking.subtotal|number_format(2) }}</span>
                    </div>
                    <div class="flex justify-between mt-2">
                        <span class="text-sm text-gray-500">Service fee</span>
                        <span class="text-sm text-gray-900">€{{ booking.serviceFee|number_format(2) }}</span>
                    </div>
                    <div class="flex justify-between mt-3 pt-3 border-t">
                        <span class="text-lg font-bold text-gray-900">Total paid</span>
                        <span class="text-lg font-bold text-blue-600">€{{ booking.total|number_format(2) }}</span>
                    </div>
                </div>
            </div>
            
            <!-- Total Tickets -->
            <div class="text-center bg-gray-50 rounded-lg py-4 mb-4">
                <div class="text-sm text-gray-500 mb-1">Total tickets</div>
                <div class="text-2xl font-bold text-gray-900">{{ total_tickets_booking }}</div>
            </div>
            
            <!-- Footer -->
            <div class="text-center">
                <p class="text-sm text-gray-500 mb-2">
                    Thank you for your purchase!
                </p>
                <p class="text-xs text-gray-400">
                    Need help? <a href="mailto:support@bilbostack.com" class="text-blue-600" style="color: #2563eb; text-decoration: none;">Contact support</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>