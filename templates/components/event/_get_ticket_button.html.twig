{% set styleByDefault = 
  ' 
    focus:outline-none focus:ring-2 focus:ring-gray-300 
    border border-gray-300 text-gray-700 bg-transparent hover:bg-gray-100 hover:border-gray-400 hover:text-gray-900 
  '
%}

{% set disabledStyles = ' opacity-70 cursor-not-allowed pointer-events-none select-none ' %}

<div class="mt-auto">
  <a 
    href="{{ path('app_event_ticket_selection', { id: event.id }) }}"
    role="button"
    class="
      inline-flex items-center gap-1
      transition
      rounded-md
      text-sm xs:text-xs
      px-4 py-2.5 sm:px-2 sm:py-2
      font-medium
      
      {# Custom styles button #}
      {{ customStyle | default(styleByDefault) }}
      {# Disable button if sold out #}
      {% if disabled is defined and disabled %} {{ disabledStyles }} {% endif %}
    "
  >

    {# Custom Title #}
    {{ title | default('get ticket') | title }}

    {# Icon #}
    {% if icon %}
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />
      </svg>
    {% endif %}
  </a>
</div>