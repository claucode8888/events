<div class="relative flex flex-col p-6 leading-normal">

  <!-- Availability badge -->
  {% if availabilityTicketsByEvent[event.id] is defined %}
    <div class="absolute top-4 right-4 z-10">
      {% include 'components/event/_availability_badge.html.twig'
        with {
          'availability': availabilityTicketsByEvent[event.id]['availability'],
          'cardStyles': true
        }
      %}
    </div>
  {% endif %}
  <!-- End Availability badge -->

  <!-- Title -->
  <div class="mb-1 text-xl font-bold tracking-tight text-gray-900">
    <h5>{{ event.name }}</h5>
  </div>
  <!-- End Title -->

  <!-- DateTime -->
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    <span>{{ event.startAt|date('M d, Y') }}</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span>{{ event.startAt|date('H:i') }}</span>
  </div>
  <!-- End DateTime -->

  <!-- Description -->
  <div class="text-gray-600 text-sm leading-relaxed h-16">
    {% if event.description | length > 120 %}
      {{ event.description | slice(0, 120) ~ '...' }}
    {% else %}
      {{ event.description }}
    {% endif %}
  </div>
  <!-- End Description -->
</div>