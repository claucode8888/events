{% set badgeStyles = {
    'soldout': 'font-bold text-white bg-red-400 rounded-lg p-1.5 shadow',
    'lowerfive': 'font-bold text-white bg-gradient-to-r from-orange-400 to-red-500 rounded-lg p-1.5 shadow',
    'lowerten': 'font-semibold text-white bg-amber-300 rounded-lg p-1.5 shadow',
    'available': 'hidden'
  }
%}

{% set defaultStyles = {
  'soldout': 'font-bold text-red-400',
  'lowerfive': 'font-bold text-red-400 animate-pulse',
  'lowerten': 'font-semibold text-amber-600',
  'available': 'font-semibold text-gray-600'
  }
%}

{% if availability == 0 %}
  {% set style = 'soldout' %}
  {% set title = 'sold out' %}

{% elseif availability < 5 %}
  {% set title = '🔥 ' ~ availability ~ ' left' %}
  {% set style = 'lowerfive' %}

{% elseif availability < 10 %}
  {% set title = availability ~ ' left' %}
  {% set style = 'lowerten' %}

{% else %}
  {% set title = 'available' %}
  {% set style = 'available' %}
{% endif %}

  <span class="
    text-xs 
    {% if cardStyles | default(false) %}
      {{ badgeStyles[style] }}
    {% else %}
      {{ defaultStyles[style] }}
    {% endif %}
  ">
    {{ title | title }}
  </span>


