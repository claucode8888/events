{% extends 'base.html.twig' %}

{% block title %}Account created{% endblock %}

{% block body %}
  <div class="min-h-screen flex flex-col justify-center px-6 py-12 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-sm flex flex-col justify-center items-center">
      {% include 'components/logo.html.twig' with { outApp: true } %}
    </div>

    <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">

      <div class="text-center space-y-4 text-gray-300">
        <p>
          Your account has been created successfully.
        </p>

        <p>
          We’ve sent you a verification email. Please check your inbox and confirm your email address before signing in.
        </p>

        <p class="text-sm text-gray-400">
          If you don’t see the email, check your junk folder.
        </p>

        {# <a href="{{ path('app_home') }}"
          class="inline-block mt-4 w-full border border-white btn-primary text-center">
          Go Back
        </a> #}
      </div>

    </div>
  </div>
{% endblock %}