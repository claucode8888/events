<div class="fixed top-24 right-4 left-4 md:left-auto md:w-96 z-50 space-y-2">
  {% for label, messages in app.flashes %}
    {% for message in messages %}
      {% set color = {
        'success': 'green',
        'error': 'red',
        'danger': 'red',
        'warning': 'yellow',
        'info': 'blue'
      }[label]|default('gray')
    %}

      <div class="relative p-4 rounded-md shadow-md border-l-4 border-{{ color }}-500 bg-{{ color }}-50 text-{{ color }}-700">
        <button
          onclick="this.parentElement.remove()"
          class="absolute top-2 right-2 text-{{ color }}-800 hover:text-{{ color }}-900 cursor-pointer"
          title="Close"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <div class="pr-6 text-sm">{{ message }}</div>
      </div>
    {% endfor %}
  {% endfor %}
</div>