<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Ticket PDF</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      color: #333;
      margin: 0;
      padding: 15px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    .container {
      max-width: 700px;
      margin: 0 auto;
    }

    /* Header */
    .header {
      text-align: center;
      border-bottom: 2px solid #ccc;
      padding: 1em;
      margin-bottom: 10px;
      position: relative;
      background-color: #001223;
      color: #fff;
    }

    .header-logo {
      position: absolute;
      left: 10;
      top: 10;
      height: 40px;
    }

    .header-logo img {
      height: 40px;
    }

    .header h1 {
      font-size: 18px;
      margin: 0;
    }

    .header p {
      font-size: 11px;
      margin: 4px 0 0;
    }

    /* QR */
    .qr-section {
      text-align: center;
      border: 1px solid #ccc;
      background: #f9f9f9;
      padding: 10px;
      margin-bottom: 10px;
    }

    .qr-box {
      border: 1px solid #ccc;
      display: inline-block;
      padding: 6px;
      background: #fff;
      margin: 5px 0;
    }

    .qr-box img {
      width: 120px;
      height: 120px;
    }

    .qr-label {
      font-weight: bold;
      margin-top: 5px;
      margin-bottom: 2px;
    }

    .qr-id {
      font-size: 9px;
      color: #777;
      word-break: break-all;
    }

    /* Sections */
    .section {
      border: 1px solid #ccc;
      margin-bottom: 10px;
    }

    .section-title {
      font-weight: bold;
      padding: 6px;
      border-bottom: 1px solid #ccc;
      background: #f3f3f3;
    }

    .section-content {
      padding: 8px;
      vertical-align: top;
    }

    .label {
      font-size: 10px;
      color: #777;
    }

    .value {
      font-size: 13px;
      font-weight: bold;
    }

    .right {
      text-align: right;
    }

    /* Footer */
    .footer {
      text-align: center;
      font-size: 9px;
      color: #999;
      border-top: 1px solid #ddd;
      padding-top: 6px;
      margin-top: 10px;
    }

    @page {
      margin: 10mm;
    }

  </style>
</head>

<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <div class="header-logo">
        <img src="{{ logo }}" alt="EventHub Logo">
      </div>

      <h1>Ticket Details</h1>
      <p>
        Booking ID: <strong>#{{ ticket.booking.id }}</strong> |
        Present this at entrance
      </p>
    </div>

    <!-- QR -->
    <div class="qr-section">
      <div>Scan at entrance</div>

      <div class="qr-box">
        <img src="{{ qr }}" alt="QR Code">
      </div>

      <div class="qr-label">{{ ticket.category.name }}</div>
      <div class="qr-id">{{ ticket.qrtoken }}</div>
    </div>

    <!-- Ticket Information -->
    <table class="section">
      <tr>
        <td colspan="2" class="section-title">Ticket Information</td>
      </tr>
      <tr>
        <td class="section-content" colspan="2">
          <div class="label">Attendant</div>
          <div class="value">{{ ticket.booking.user.profile.fullName }}</div>
        </td>
      </tr>
      <tr>
        <td class="section-content">
          <div class="label">Ticket Type</div>
          <div class="value">{{ ticket.category.name|title }}</div>
        </td>
        <td class="section-content right">
          <div class="label">Price</div>
          <div class="value">€{{ ticket.category.price|number_format(2) }}</div>
        </td>
      </tr>
    </table>

    <!-- Event Information -->
    <table class="section">
      <tr>
        <td colspan="2" class="section-title">Event Information</td>
      </tr>
      <tr>
        <td class="section-content">
          <div class="label">Event</div>
          <div class="value">{{ ticket.category.event.name }}</div>
        </td>
        <td class="section-content">
          <div class="label">Date & Time</div>
          <div class="value">{{ ticket.category.event.startAt|date('M j, Y - g:i A') }}</div>
        </td>
      </tr>
      <tr>
        <td class="section-content" colspan="2">
          <div class="label">Location</div>
          <div class="value">{{ ticket.category.event.location }}</div>
        </td>
      </tr>
    </table>

    <!-- Footer -->
    <div class="footer">
      Generated on {{ "now"|date("M j, Y") }} — Ticket #{{ ticket.booking.id }}
    </div>
  </div>
</body>
</html>