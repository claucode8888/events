<div class="col-span-12 p-2 mb-4">
  <div class="bg-white rounded-xl shadow-sm w-full overflow-hidden">
    <div class="p-5 border-b border-gray-100">
      <!-- Grid layout for the 2 columns -->
      <div class="grid grid-cols-12 gap-3">
        
        <!-- Column 1: Image with date -->
        <div class="col-span-12 md:col-span-4">
          <div class="flex gap-2">
            <!-- Date badge -->
            <div class="hidden lg:flex flex-col items-center justify-center bg-gray-100 rounded-lg p-2 w-14 self-start">
              <span class="text-amber-500 text-xs font-semibold uppercase">
                {{ ticket.category.event.startAt|date('M') }}
              </span>
              <span class="text-2xl font-bold text-gray-800 leading-tight">
                {{ ticket.category.event.startAt|date('d') }}
              </span>
            </div>

            <!-- Image -->
            <div class="flex-1">
              {% include 'components/event/_img_event.html.twig' with {event: ticket.category.event} %}
            </div>
          </div>
        </div>
        
        <!-- Column 2: Details -->
        <div class="col-span-12 md:col-span-8">

          <!-- Name Event -->
          <div class="mb-2">
            <h3 class="text-xl font-bold text-gray-900 font-sans tracking-tight">
              {{ ticket.category.event.name }}
            </h3>
            <p class="text-gray-500 text-sm mt-1 font-medium tracking-wide">
              {{ ticket.category.name }}
            </p>
          </div>
          <!-- End Name Event -->

          <!-- DateTime -->
          <div class="flex items-center gap-1 text-sm text-gray-500 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>{{ ticket.category.event.startAt|date('M d, Y') }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{{ ticket.category.event.startAt|date('H:i') }}</span>
          </div>
          <!-- End DateTime -->

          <!-- Booking Details -->
          <div class="text-gray-700 text-sm mt-2 leading-relaxed">
            <span class="font-medium">Booking n.°</span>
            <span class="font-bold text-gray-900">{{ ticket.booking.id }}</span> 
            for
            <span class="font-semibold">
              ({{ ticket.category.price|format_currency('EUR', locale='en') }})
            </span>
            purchased at
            <span class="font-medium">
              {{ ticket.booking.createdAt|date('D') }}., 
              {{ ticket.booking.createdAt|date('M') }}. 
              {{ ticket.booking.createdAt|date('d') }}, 
              {{ ticket.booking.createdAt|date('g:i A') }}
            </span>
          </div>
          <!-- End Booking Details -->

          <!-- Actions -->
          <div class="flex justify-start gap-3 mt-4 pt-4 border-t border-gray-200">
            <a href="{{ path('app_event_details', { id: ticket.category.event.id }) }}" 
              class="inline-flex items-center justify-center gap-1 text-sm text-gray-700 border border-gray-200 hover:border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-lg transition duration-200">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              View Event
            </a>

            <a href="{{ path('app_ticket_details', { id: ticket.id }) }}" 
              class="inline-flex items-center justify-center gap-1 text-sm text-gray-700 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded-lg transition duration-200">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
              </svg>
              View Ticket
            </a>
          </div>
        </div>
        
      </div> <!-- End Grid layout for the 2 columns -->
    </div>
  </div>
</div>