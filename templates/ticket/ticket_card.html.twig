{% set cols = tickets | length == 1 ? 'lg:col-start-1 lg:col-span-8 md:col-start-1 md:col-span-8 ' : '' %}
<div class="
  {{ cols }}
  col-span-12
  p-2 mb-4">
  <div class="bg-white rounded-xl shadow-sm w-full overflow-hidden">
    <div class="p-5 border-b border-gray-100">
      <!-- Grid layout for the 2 columns -->
      <div class="grid grid-cols-12 gap-3">
        
        <!-- Column 1: Image with date -->
        <div class="col-span-12 md:col-span-4">
          <div class="flex gap-2">
            <!-- Date badge -->
            <div class="flex flex-col items-center justify-center bg-gray-100 rounded-sm p-1 w-12 self-start">
              <span class="text-amber-400 text-xs font-semibold">
                {{ ticket.category.event.startAt | date('M') | upper }}.
              </span>
              <span class="text-xl font-bold text-gray-800">
                {{ ticket.category.event.startAt | date('d') }}
              </span>
            </div>

            <!-- Image -->
            <div class="relative overflow-hidden rounded-xl shadow-md flex-1">
              <img
                class="object-cover w-full h-44 transition-transform duration-300 hover:scale-105"
                src="{{ asset(uploads_events ~ '/' ~ ticket.category.event.imgPath) }}"
                alt="{{ ticket.category.event.name }}"
              >
              <div class="absolute inset-0 bg-gradient-to-t from-black/40"></div>
            </div>
          </div>
        </div>
        
        <!-- Column 2: Details -->
        <div class="col-span-12 md:col-span-8">
          <!-- Details -->
          <div>
            <h1 class="text-xl font-bold text-gray-900 font-sans tracking-tight">
              {{ ticket.category.event.name }}
            </h1>
            <p class="text-gray-500 text-sm mt-1 font-medium tracking-wide">
              {{ ticket.category.name }}
            </p>
            <p class="text-gray-500 text-sm mt-3 font-normal tracking-normal">
              {{ ticket.category.event.startAt | date('D') }}., 
              {{ ticket.category.event.startAt | date('M') }}. 
              {{ ticket.category.event.startAt | date('d') }}, 
              {{ ticket.category.event.startAt | date('g:i A') }}
            </p>
            <p class="text-gray-700 text-sm mt-2 leading-relaxed">
              <span class="font-medium">Booking n.°</span>
              <span class="font-bold text-gray-900">{{ ticket.booking.id }}</span> 
              for
              <span class="font-semibold">
                ({{ ticket.category.price | format_currency('EUR', locale='en') }})
              </span>
              purchased at
              <span class="font-medium">
                {{ ticket.booking.createdAt | date('D') }}., 
                {{ ticket.booking.createdAt | date('M') }}. 
                {{ ticket.booking.createdAt | date('d') }}, 
                {{ ticket.booking.createdAt | date('g:i') }}
              </span>
            </p>
          </div>
          
          <!-- Actions -->
          <div class="flex justify-center gap-3 mt-4 pt-4 border-t border-gray-200">
            <a href="{{ path('app_event_show', { id: ticket.category.event.id }) }}" 
              class="inline-flex items-center justify-center gap-1 text-sm text-gray-700 border border-gray-200 hover:border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 rounded-lg transition duration-200">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              View Event
            </a>

            <a href="{{ path('app_ticket_details', { id: ticket.id }) }}" 
              class="inline-flex items-center justify-center gap-1 text-sm text-gray-700 hover:text-gray-900 bg-gray-100 hover:bg-gray-200 px-4 py-2 rounded-lg transition duration-200">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
              </svg>
              View Ticket
            </a>
          </div>
        </div>
        
      </div> <!-- End grid -->
    </div>
  </div>
</div>