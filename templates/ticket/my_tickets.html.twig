{% extends 'layout.html.twig' %}

{% block title %}My Tickets{% endblock %}

{% block content %}
  <div class="grid grid-cols-1">
    <!-- User summary data -->
    <section class="bg-white rounded-xl shadow p-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">My Account</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="text-center p-4 bg-gray-50 rounded-lg">
          <p class="text-3xl font-bold text-blue-900">{{ tickets|length }}</p>
          <p class="text-gray-600">Total Tickets</p>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-lg">
          <p class="text-3xl font-bold text-green-600">
            {{ tickets|filter(t => t.category.event.startAt > date())|length }}
          </p>
          <p class="text-gray-600">Upcoming Events</p>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-lg">
          <p class="text-3xl font-bold text-gray-600">
            {{ tickets|filter(t => t.category.event.startAt <= date())|length }}
          </p>
          <p class="text-gray-600">Past Events</p>
        </div>
      </div>
    </section>
    <!-- End User summary data -->

    <!-- Tickets section -->
    <section>
      {% if tickets | length > 0 %}
        <article class="grid grid-cols-12 gap-4 p-6">
          {% for ticket in tickets %}
            {% include 'ticket/ticket_card.html.twig' %}
          {% endfor %}
        </article>
      {% else %}
        <article class="min-h-[50vh] flex flex-col items-center justify-center p-6">
          <div class="text-center">
            <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
            </svg>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">No tickets yet</h2>
            <p class="text-gray-600 mb-6">You haven't purchased any tickets yet.</p>
            <a href="{{ path('app_event_index') }}" class="bg-blue-900 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-lg transition duration-200">
              Browse Events
            </a>
          </div>
        </article>
      {% endif %}
    </section>
    <!-- End Tickets section -->
  </div>
{% endblock %}