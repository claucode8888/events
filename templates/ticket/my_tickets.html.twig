{% extends 'layout.html.twig' %}

{% block title %}My Tickets{% endblock %}

{% block content %}
  <div class="grid grid-cols-1">
    <!-- Tickets Summary -->
    <section class="border-b border-gray-100 p-2">
      <nav aria-label="Tickets searcher">
        <ul class="flex flex-wrap items-center justify-center gap-2 p-4">
          {% for type, item in searches %}
            <li>
              <a
                href="{{ path('app_my_tickets', { search: type }) }}"
                class="px-4 py-2.5 rounded-md text-sm font-medium transition-all duration-200 
                  {% if item.active %}
                    shadow-md ring-2 ring-amber-400 ring-offset-1
                  {% else %}
                    bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 hover:border-amber-300
                  {% endif %}"
              >
                {{ item.title|title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </section>
    <!-- End Tickets Summary -->

    <!-- Tickets section -->
    <section>
      {% if myTickets | length > 0 %}
        <article class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
          <!-- Title tickets -->
          <h2 class="text-xl text-gray-600 font-bold flex flex-wrap items-center gap-3 col-span-full">
            {{ searches[currentSearch].title|title }}
            <span class="bg-gray-100 text-gray-600 text-sm font-medium px-3 py-1">
              {{ myTickets|length }} ticket{{ myTickets|length != 1 ? 's' : '' }}
            </span>
          </h2>
          <!-- End Title tickets -->
          
          <!-- Tickets -->
          {% for ticket in myTickets %}
            {% include 'ticket/ticket_card.html.twig' %}
          {% endfor %}
          <!-- End Tickets -->
        </article>
      {% else %}
        <article class="min-h-[50vh] flex flex-col items-center justify-center p-6">
          <div class="text-center">
            <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
            </svg>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">No tickets</h2>

            {% if currentSearch != pastSearch %}
              <div class="text-gray-600">
                <p>You haven't purchased any tickets yet.</p>
              </div>
            {% endif %}

            <div class="mt-6">
              <a href="{{ path('app_event_index') }}" class="btn-primary">
                Browse Events
              </a>
            </div>
          </div>
        </article>
      {% endif %}
    </section>
    <!-- End Tickets section -->
  </div>
{% endblock %}