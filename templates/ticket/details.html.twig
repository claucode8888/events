{% extends 'layout.html.twig' %}

{% block title %}Ticket details{% endblock %}

{% block content %}
  <article class="max-w-3xl mx-auto p-5 font-sans text-xs text-gray-700 leading-relaxed">
    <!-- Header -->
    <header class="text-center mb-8 border-b-2 pb-5">
      <h1 class="text-2xl m-0 mb-2.5 font-bold">Ticket Details</h1>
      <p class="text-gray-500 m-1">Booking ID:
        <strong>
          #{{ ticket.booking.id }}
        </strong>
      </p>
      <p class="text-gray-500 m-1 print:hidden">This is your digital ticket. Present at entrance.</p>
    </header>
    <!-- End Header -->

    <!-- Ticket Info -->
    <section class="mb-6 break-inside-avoid border border-gray-300 rounded p-5 bg-white">
      <h2 class="text-base font-bold mb-4 pb-1 border-b border-gray-300">Ticket Information</h2>
      <div class="flex justify-between items-start">
        <div>
          <span class="text-xs text-gray-500 uppercase tracking-wide mb-1">Ticket Type</span>
          <div class="text-lg font-bold">{{ ticket.category.name | title }}</div>
        </div>
        <div class="text-right">
          <span class="text-xs text-gray-500 uppercase tracking-wide mb-1">Price</span>
          <div class="text-lg font-bold">€{{ ticket.category.price|number_format(2) }}</div>
        </div>
      </div>
    </section>
    <!-- End Ticket Info -->

    <!-- QR Code -->
    <section class="text-center border border-gray-300 rounded p-5 mb-6 bg-gray-50">
      <h2 class="text-base font-bold mb-2.5">Your Ticket QR Code</h2>
      <p class="text-xs text-gray-500 mb-4">Present this at the entrance for admission</p>
      <div class="flex justify-center my-4">
        <div class="border border-gray-300 p-2.5 bg-white inline-block">
          {% include 'ticket/_qr.html.twig' with {qrtoken: ticket.qrtoken} %}
        </div>
      </div>
      <div class="font-mono text-xs text-gray-500 mt-4">
        Ticket ID: {{ ticket.qrtoken }}
      </div>
    </section>
    <!-- End QR Code -->

    <!-- Event Info -->
    <section class="mb-6 break-inside-avoid border border-gray-300 rounded p-5 bg-white">
      <h2 class="text-base font-bold mb-4 pb-1 border-b border-gray-300">Event Information</h2>
      <div class="grid grid-cols-2 gap-4 mt-2.5">
        <div class="border border-gray-300 p-4 rounded">
          <span class="text-xs text-gray-500 uppercase tracking-wide mb-1">Event</span>
          <div class="font-bold text-sm">{{ ticket.category.event.name }}</div>
        </div>
        <div class="border border-gray-300 p-4 rounded">
          <span class="text-xs text-gray-500 uppercase tracking-wide mb-1">Date</span>
          <div class="font-bold text-sm">{{ ticket.category.event.startAt|date('M j, Y') }}</div>
        </div>
        <div class="border border-gray-300 p-4 rounded">
          <span class="text-xs text-gray-500 uppercase tracking-wide mb-1">Time</span>
          <div class="font-bold text-sm">{{ ticket.category.event.startAt|date('g:i A') }}</div>
        </div>
        <div class="border border-gray-300 p-4 rounded">
          <span class="text-xs text-gray-500 uppercase tracking-wide mb-1">Location</span>
          <div class="font-bold text-sm">{{ ticket.category.event.location }}</div>
        </div>
      </div>
    </section>
    <!-- End Event Info -->

    <!-- Payment Summary -->
    <section class="mb-6 break-inside-avoid border border-gray-300 rounded p-5 bg-white">
      <h2 class="text-base font-bold mb-4 pb-1 border-b border-gray-300">Payment Summary</h2>
      <div class="bg-blue-50 border border-sky-200 p-5 rounded">
        <div class="flex justify-between mb-2">
          <span>{{ ticket.category.name | title }} Ticket</span>
          <span>€{{ ticket.category.price|number_format(2) }}</span>
        </div>
        <div class="flex justify-between mb-2">
          <span>Service Fee</span>
          <span>€0.00</span>
        </div>
        <div class="flex justify-between text-base font-bold border-t-2 border-gray-300 pt-2.5 mt-2.5">
          <span>Total Paid</span>
          <span>€{{ ticket.category.price|number_format(2) }}</span>
        </div>
      </div>
    </section>
    <!-- End Payment Summary -->

    <!-- Actions -->
    <div class="flex justify-center items-center mt-8 print:hidden">
      <a
        href="{{ path('app_my_tickets') }}"
        class="btn-primary text-sm py-3"
      >
        Back to My Tickets
      </a>
    </div>
    <!-- End Actions -->
  </article>
{% endblock %}