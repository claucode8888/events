{% extends 'layout.html.twig' %}

{% block title %}Ticket details{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto p-6">
  {# Ticket Details #}
  <div class="bg-white border rounded-lg p-6 mb-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Ticket Details</h1>
        <p class="text-gray-600 mt-1">Booking #{{ ticket.booking.id }}</p>
      </div>
      <div class="text-right">
        <div class="text-lg font-bold text-gray-900">
          {{ ticket.category.price|format_currency('EUR', locale='en') }}
        </div>
        <p class="text-sm text-gray-500 mt-1">
          {{ ticket.category.name | title }} Ticket
        </p>
      </div>
    </div>
  </div>

  {# QR Code #}
  <div class="bg-white border rounded-lg p-6 mb-6 text-center">
    <h2 class="text-lg font-bold mb-2">Your Ticket QR Code</h2>
    <p class="text-sm text-gray-600 mb-4">Present this at the entrance</p>
    <div class="flex justify-center">
      {% include 'ticket/_qr.html.twig' with {qrtoken: ticket.qrtoken} %}
    </div>
    <p class="text-xs text-gray-500 mt-4">Ticket ID: {{ ticket.qrtoken|slice(0, 8) }}...</p>
  </div>

  {# Event Info #}
  <div class="bg-white border rounded-lg p-6 mb-6">
    <h2 class="text-lg font-bold mb-4">Event Info</h2>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <div class="text-sm text-gray-500">Event</div>
        <div class="font-medium">{{ ticket.category.event.name }}</div>
      </div>
      <div>
        <div class="text-sm text-gray-500">Date</div>
        <div class="font-medium">{{ ticket.category.event.startAt|date('M j, Y') }}</div>
      </div>
      <div>
        <div class="text-sm text-gray-500">Time</div>
        <div class="font-medium">{{ ticket.category.event.startAt|date('g:i A') }}</div>
      </div>
      <div>
        <div class="text-sm text-gray-500">Status</div>
        <div class="font-medium">
          {% if ticket.status == 'valid' %}
            {% set statusColor = ' text-green-800 bg-green-100' %}
          {% elseif ticket.status == 'used' %}
            {% set statusColor = ' text-gray-800 bg-gray-100' %}
          {% else %}
            {% set statusColor = ' text-yellow-800 bg-yellow-100' %}
          {% endif %}
          <span class="px-2 py-1 text-xs rounded-full {{ statusColor }}">
            {{ ticket.status | upper }}
          </span>
        </div>
      </div>
    </div>
  </div>

  {# Total #}
  <div class="bg-white border rounded-lg p-6 mb-6">
    <h2 class="text-lg font-bold mb-4">Payment Summary</h2>
    <div class="space-y-2">
      <div class="flex justify-between">
        <span>Service Fee</span>
        <span>€0.00</span>
      </div>
      <hr class="my-2">
      <div class="flex justify-between text-lg font-bold">
        <span>Total</span>
        <span>€{{ ticket.category.price | number_format(2) }}</span>
      </div>
    </div>
  </div>

  {# Actions #}
  <div class="flex gap-4">
    <button onclick="window.print()" 
      class="w-1/2 flex justify-center items-center gap-2 bg-blue-900 hover:bg-blue-700 text-white py-3 rounded font-medium cursor-pointer transition duration-200">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
      </svg>
      Print
    </button>
    <a href="{{ path('app_my_tickets') }}" 
      class="w-1/2 border border-gray-300 text-gray-700 py-3 rounded font-medium text-center hover:bg-gray-50 transition duration-200">
      Back to My Tickets
    </a>
  </div>
</div>
{% endblock %}