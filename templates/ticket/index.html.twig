{% extends 'layout.html.twig' %}

{% block title %}My Tickets{% endblock %}

{% block content %}
  {% if tickets | length > 0 %}
    <div class="grid grid-cols-12 gap-4 p-6">
      {% for ticket in tickets %}
        <div class="
          lg:col-start-5 lg:col-span-8
          md:col-start-4 md:col-span-9
          col-span-12
          p-2 mb-4">
          <div class="bg-white rounded-xl shadow-md w-full overflow-hidden">
            <div class="p-5 border-b border-gray-100">
              <div class="flex justify-between items-start">
                <div class="flex justify-center gap-2">
                  <div class="flex flex-col items-center">
                    <span class="flex flex-col bg-gray-100 rounded-sm p-2">
                      <span class="text-amber-400 text-xs font-semibold">
                        {{ ticket.category.event.startAt | date('M') | upper }}.
                      </span>
                      <span class="text-2xl font-bold text-gray-800">
                        {{ ticket.category.event.startAt | date('d') }}
                      </span>
                    </span>
                  </div>
                  
                  <div class="flex justify-center relative overflow-hidden rounded-t-xl shadow-md">
                    <img
                      class="object-cover w-full h-44 transition-transform duration-300 hover:scale-105"
                      src="{{ asset(uploads_events ~ '/' ~ ticket.category.event.imgPath) }}"
                      alt="{{ ticket.category.event.name }}"
                    >
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40"></div>
                  </div>
                  
                  <div class="p-5">
                    <h1 class="text-xl font-bold text-gray-900 font-sans tracking-tight">
                      {{ ticket.category.event.name }}
                    </h1>
                    <p class="text-gray-500 text-sm mt-1 font-medium tracking-wide">
                      {{ ticket.category.name }}
                    </p>
                    <p class="text-gray-500 text-sm mt-3 font-normal tracking-normal">
                      {{ ticket.category.event.startAt | date('D') }}., 
                      {{ ticket.category.event.startAt | date('M') }}. 
                      {{ ticket.category.event.startAt | date('d') }}, 
                      {{ ticket.category.event.startAt | date('g:i A') }}
                    </p>
                    <p class="text-gray-700 text-sm mt-2 leading-relaxed">
                      <span class="font-medium">Booking n.°</span>
                      <span class="font-bold text-gray-900">{{ ticket.booking.id }}</span> 
                      for
                      <span class="font-semibold">
                        ({{ ticket.category.price | format_currency('EUR', locale='en') }})
                      </span>
                      purchased at
                      <span class="font-medium">
                        {{ ticket.booking.createdAt | date('D') }}., 
                        {{ ticket.booking.createdAt | date('M') }}. 
                        {{ ticket.booking.createdAt | date('d') }}, 
                        {{ ticket.booking.createdAt | date('g:i') }}
                      </span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="min-h-[50vh] flex flex-col items-center justify-center p-6">
      <div class="text-center">
        <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
        </svg>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">No tickets yet</h2>
        <p class="text-gray-600 mb-6">You haven't purchased any tickets yet.</p>
        <a href="{{ path('app_event_index') }}" class="bg-blue-900 hover:bg-blue-700 text-white font-medium py-2 px-6 rounded-lg transition duration-200">
          Browse Events
        </a>
      </div>
    </div>
  {% endif %}
{% endblock %}