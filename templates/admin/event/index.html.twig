
{% extends 'layout.html.twig' %}

{% block title %}Events {% endblock %}

{% block content %}
    <section class="mx-auto max-w-7xl px-6 py-6">
      <h1 class="mb-6 text-xl font-semibold text-gray-800">
        Events: ({{ events | length }})
      </h1>

      <!-- Create button -->
      {% if events | length > 10 %}
      <div class="flex justify-end">
        <a href="{{ path('app_admin_event_new') }}" class="btn-primary">Create new</a>
      </div>
      {% endif %}
      <!-- End create button -->

      <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm m-2">
        <table class="min-w-[900px] w-full whitespace-nowrap text-sm">
          <!-- Head -->
          <thead class="bg-gray-100 text-xs uppercase text-gray-600">
            <tr>
              <th class="px-4 py-3 text-left">ID</th>
              <th class="px-4 py-3 text-left">Title</th>
              <th class="px-4 py-3 text-left md:table-cell">Capacity</th>
              <th class="px-4 py-3 text-left lg:table-cell">Status</th>
              <th class="px-4 py-3 text-left hidden xl:table-cell">Created</th>
              <th class="px-4 py-3 text-left hidden xl:table-cell">StartAt</th>
              <th class="px-4 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <!-- Head -->
          <!-- Body -->
          <tbody class="divide-y divide-gray-200 text-gray-700">
            {% for event in events %}
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-medium">{{ event.id }}</td>
                <td class="px-4 py-3">{{ event.name }}</td>
                <td class="px-4 py-3 md:table-cell">{{ event.capacity }}</td>
                <td class="px-4 py-3 lg:table-cell">
                  <span class="inline-flex px-2 py-1.5 text-xs font-semibold bg-{{ event.status.color }}-100 text-{{ event.status.color }}-700">
                    {{ event.status.name }}
                  </span>
                </td>
                <td class="px-4 py-3 hidden xl:table-cell">{{ event.createdAt ? event.createdAt | date('Y-m-d H:i:s') : '' }}</td>
                <td class="px-4 py-3 hidden xl:table-cell">{{ event.startAt ? event.startAt | date('Y-m-d H:i:s') : '' }}</td>
                <td class="px-4 py-3 text-right">
                  <div class="flex justify-end items-center gap-1.5">
                    <div>
                      <a
                        href="{{ path('app_admin_event_edit', {'id': event.id}) }}"
                        class="rounded-md border border-gray-200 bg-white p-2 text-gray-500 inline-flex items-center transition-colors duration-200
                          hover:border-gray-200 hover:bg-gray-50 hover:text-gray-600
                        "
                        title="Edit event"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                      </a>
                    </div>
                    <div>
                      {% include 'admin/event/_delete_form.html.twig' %}
                    </div>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
          <!-- Body -->
        </table>
      </div>

      <!-- Create button -->
      <div class="flex justify-end">
        <a href="{{ path('app_admin_event_new') }}" class="btn-primary">Create new</a>
      </div>
      <!-- End create button -->
    </section>
  {% include 'admin/event/js/_delete_form.js.html.twig' %}
{% endblock %}