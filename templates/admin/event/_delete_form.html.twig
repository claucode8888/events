<form
  method="post"
  action="{{ path('app_admin_event_delete', {'id': event.id}) }}"
  class="inline"
  data-event="{{ event.name }}"
>
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
  <button
    type="submit"
    class="rounded-md border border-gray-200 bg-white p-2 text-gray-500 
    hover:bg-red-50 hover:text-red-600 hover:border-red-200 inline-flex 
      items-center transition-colors duration-200 cursor-pointer" title="Delete event"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
      />
    </svg>
  </button>
</form>