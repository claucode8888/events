<script>
  const radioSelect = document.querySelector('input[value="select"]');
  const radioCreate = document.querySelector('input[value="create"]');
  const selectBlock = document.getElementById('organizer_choices_block');
  const createBlock = document.getElementById('organizer_creation_block');

  function toggleOrganizerMode(){
    if (radioSelect.checked) {
      selectBlock.classList.remove('hidden');
      createBlock.classList.add('hidden');
    } else {
      selectBlock.classList.add('hidden');
      createBlock.classList.remove('hidden');
    }
  }

  radioSelect.addEventListener('change', toggleOrganizerMode);
  radioCreate.addEventListener('change', toggleOrganizerMode);
  toggleOrganizerMode();
</script>