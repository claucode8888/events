<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper   = document.getElementById('ticket-categories-wrapper');
    const addButton = document.getElementById('add-ticket-category');

    // Symfony prototype (escaped for JS)
    const prototype = `{{ ticketCategoryPrototype|e('js') }}`;

    let index = wrapper.children.length;

  // Add a new Ticket Category row
    addButton.addEventListener('click', () => {
      const html = prototype.replace(/__name__/g, index);

      const temp = document.createElement('div');
      temp.innerHTML = html;
      const row = temp.firstElementChild;
      wrapper.appendChild(row);
      index++;
    });

    // Handle deletion of a Ticket Category
    wrapper.addEventListener('click', function (e) {
      const deleteButton = e.target.closest('.remove-ticket-category');
      if (!deleteButton) return;

      const row = deleteButton.closest('.ticket-category-row');
      if (!row) return;

      const deleteInput = row.querySelector('input[type="hidden"][name$="[_delete]"]');
      if (!deleteInput) {
        console.error('Hidden _delete field not found in this row.');
        return;
      }

      // Mark this entity for deletion
      deleteInput.value = '1';

      // Hide it from the UI (but keep it in the form submission)
      row.style.display = 'none';
    });

  });
</script>