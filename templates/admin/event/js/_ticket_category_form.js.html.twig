<script>
  const wrapper = document.getElementById('ticket-categories-wrapper');
  const addButton = document.getElementById('add-ticket-category');
  const prototype = `{{ TCprototype |e('js') }}`;
  let index = wrapper.querySelectorAll('.ticket-category-row').length

  // Add new Ticket Category 
  addButton.onclick = (e) => {
    e.preventDefault();
    const newHtml = prototype.replace(/__name__/g, index);
    wrapper.insertAdjacentHTML('beforeend', newHtml);
    index++;
  }

  // Delete Ticket Category 
  wrapper.onclick = (e) => {
    if (!e.target.closest('.remove-ticket-category')) return;
    e.preventDefault();
    const row = e.target.closest('.ticket-category-row');
    const deleteInput = row.querySelector('input[name$="[_delete]"]');
    
    if (deleteInput) {
      deleteInput.value = '1';
      row.style.display = 'none';
      
      // Disable ALL inputs in hidden row
      row.querySelectorAll('input').forEach(input => {
        input.disabled = true;
      });
    }
  };
</script>