<div class="space-y-4">
  <label class="{{ labelClasses }}">Ticket categories</label>
  {% if form.ticketCategories.vars.errors|length %}
    <span class="text-red-600 text-xs mt-1">
      {{ form_errors(form.ticketCategories) }}
    </span>
  {% endif %}

  <div id="ticket-categories-wrapper" class="space-y-4">
    {% for ticketCategory in form.ticketCategories %}
      {% include 'admin/event/_ticket_category_row.html.twig' with { form: ticketCategory } %}
    {% endfor %}
  </div>  

  <div class="text-right">
    <button 
      type="button"
      id="add-ticket-category"
      class="btn-primary"
      >
      Add ticket category
    </button>
  </div>
</div>