{% set labelClasses = 'block mb-1.5 text-sm font-semibold text-gray-800 ' %}
{% set inputClasses = 'w-full px-3 py-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-base ' %}

{{ form_start(form, { attr: { class: 'max-w-3xl mx-auto' } }) }}

  <div class="bg-white rounded-xl shadow-lg p-10 space-y-10">

    {# Event Name #}
    <div class="form-group">
      {{ form_label(form.name, null, { label_attr: { class: labelClasses } }) }}
      {{ form_widget(form.name, { attr: { class: inputClasses } }) }}
    </div>

    {# Description #}
    <div class="form-group">
      {{ form_label(form.description, null, { label_attr: { class: labelClasses } }) }}
      {{ form_widget(form.description, { attr: { class: inputClasses ~ ' min-h-[160px]', rows: 6 } }) }}
    </div>

    {# Image Upload #}
    <div class="flex flex-col gap-1.5">
      <div class="form-group">
        {{ form_label(form.imageFile, null, { label_attr: { class: labelClasses } }) }}
        {{ form_widget(form.imageFile, {
          attr: {
            class: inputClasses ~ '
              file:mr-2
              file:py-2 file:px-4
              file:rounded-md
              file:border-0
              file:bg-blue-900
              file:text-white
              file:text-xs
              file:font-semibold
              hover:file:bg-blue-700
              cursor-pointer
            '
          }
        }) }}
      </div>

    {# Image #}
      {% if event.imgPath %}
        <div>
          <img src="{{ asset(uploads_events ~ '/' ~ event.imgPath) }}" alt="{{ event.name }}" class="w-36 h-auto rounded-md">
        </div>
      {% endif %}
    </div>

    {# Date & Time #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <div class="form-group">
        {{ form_label(form.startAt, null, { label_attr: { class: labelClasses } }) }}
        {{ form_widget(form.startAt, { attr: { class: inputClasses } }) }}
      </div>
      <div class="form-group">
        {{ form_label(form.endAt, null, { label_attr: { class: labelClasses } }) }}
        {{ form_widget(form.endAt, { attr: { class: inputClasses } }) }}
      </div>
    </div>

    {# Capacity & Status #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <div class="form-group">
        {{ form_label(form.capacity, null, { label_attr: { class: labelClasses } }) }}
        {{ form_widget(form.capacity, { attr: { class: inputClasses } }) }}
      </div>
      <div class="form-group">
        {{ form_label(form.status, null, { label_attr: { class: labelClasses } }) }}
        {{ form_widget(form.status, { attr: { class: inputClasses ~ ' bg-white' } }) }}
      </div>
    </div>

    {# Ticket Categories #}
    {% include 'admin/event/_ticket_category_form.html.twig' %}

    {# Form Actions #}
    <div class="flex justify-center gap-2">
      <a href="{{ path('app_admin_events_index') }}" class="inline-flex items-center gap-2 px-4 py-1.5 border border-gray-300 text-gray-700 font-medium rounded-md hover:bg-gray-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Events
      </a>
      <button type="submit" class="px-4 py-1.5 bg-blue-900 text-white font-medium rounded-md hover:bg-blue-700 transition cursor-pointer">
        {{ button_label | default('Save') }}
      </button>
    </div>

  </div>

{{ form_end(form) }}