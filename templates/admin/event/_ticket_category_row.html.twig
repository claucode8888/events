<div class="grid grid-cols-1 md:grid-cols-4 gap-4 p-4 border border-gray-200 rounded-lg items-end relative">
  <div>
    {{ form_label(form.name, 'Name', { label_attr: { class: labelClasses } }) }}
    {{ form_widget(form.name, { attr: { class: inputClasses ~ (form.name.vars.errors|length ? ' border-red-500' : '') } }) }}
    {% if form.name.vars.errors|length %}
      <p class="text-red-600 text-sm mt-1">
        {{ form_errors(form.name) }}
      </p>
    {% endif %}
  </div>

  <div>
    {{ form_label(form.price, 'Price', { label_attr: { class: labelClasses } }) }}
    {{ form_widget(form.price, { attr: { class: inputClasses ~ (form.price.vars.errors|length ? ' border-red-500' : '') } }) }}
    {% if form.price.vars.errors|length %}
      <p class="text-red-600 text-sm mt-1">
        {{ form_errors(form.price) }}
      </p>
    {% endif %}
  </div>

  <div>
    {{ form_label(form.quantity, 'Quantity', { label_attr: { class: labelClasses } }) }}
    {{ form_widget(form.quantity, { attr: { class: inputClasses ~ (form.quantity.vars.errors|length ? ' border-red-500' : '') } }) }}
    {% if form.quantity.vars.errors|length %}
      <p class="text-red-600 text-sm mt-1">
        {{ form_errors(form.quantity) }}
      </p>
    {% endif %}
  </div>

  <div class="flex justify-end">
    <button type="button" class="remove-ticket-category px-3 py-1 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
      Remove
    </button>
  </div>
</div>