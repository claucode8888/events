
{% extends 'layout.html.twig' %}

{% block title %}Selection ticket for {{ event.name }}{% endblock %}

{% block content %}
<div class="grid grid-cols-12 gap-6 p-6 max-w-7xl mx-auto lg:px-6">
  <!-- Ticket categories -->
  <section class="col-span-12 lg:col-span-7">
    <!-- Event image - MOBILE ONLY (hidden on desktop) -->
    {% if event.imgPath %}
      <article class="mb-6 lg:hidden">
        <img 
          src="{{ asset(uploads_events ~ '/' ~ event.imgPath) }}" 
          alt="{{ event.name }}" 
          class="w-full h-48 object-cover rounded-xl shadow-md"
        >
      </article>
    {% endif %}
    
    <!-- Event header -->
    <article class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">{{ event.name | title }}</h1>
      <div class="flex items-center justify-center space-x-4 text-gray-600">
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span class="font-medium">{{ event.startAt | date('l, F j, Y') }}</span>
        </div>
        <div class="flex items-center">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="font-medium">{{ event.startAt | date('g:i A') }}</span>
        </div>
      </div>
    </article>

    <!-- Tickets selection -->
    <article class="mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-6">Select Your Tickets</h2>
      
      <div class="space-y-4">
        {% for ticketCategory in event.ticketCategories %}
          <div class="bg-white border border-gray-200 rounded-xl p-6 hover:border-blue-300 transition-all duration-200 shadow-sm hover:shadow-md">
            <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start mb-4">
              <div class="mb-3 lg:mb-0">
                <h3 class="text-lg font-bold text-gray-900 mb-1">{{ ticketCategory.name | title }}</h3>
                <p class="text-gray-600 text-sm">
                  {{ ticketCategory.ticketsAvailability }} tickets available
                </p>
              </div>
              
              <div class="lg:text-right">
                <div class="text-2xl font-bold text-gray-900">
                  {% if ticketCategory.price == 0 %}
                    Gratis
                  {% else %}
                    {{ ticketCategory.price | format_currency('EUR') }}
                  {% endif %}
                </div>
                <p class="text-gray-500 text-sm mt-1">per ticket</p>
              </div>
            </div>
            
            <!-- Quantity selector -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
              <span class="text-gray-700 font-medium">Quantity</span>
              
              <div class="flex items-center space-x-3">
                <button 
                  class="quantity-btn w-10 h-10 flex items-center justify-center bg-gray-100 text-gray-700 rounded-full hover:bg-gray-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                  data-ticket-id="{{ ticketCategory.id }}"
                  data-action="decrease">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                  </svg>
                </button>
                <span id="quantity-{{ ticketCategory.id }}" class="text-lg font-bold text-gray-900 w-8 text-center">0</span>
                <button
                  class="quantity-btn w-10 h-10 flex items-center justify-center bg-gray-100 text-gray-700 rounded-full hover:bg-gray-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                  data-ticket-id="{{ ticketCategory.id }}"
                  data-action="increase">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        {% else %}
          <div class="text-center py-8">
            <p class="text-gray-500">No tickets available for this event.</p>
          </div>
        {% endfor %}
      </div>
    </article>

    <!-- Register (for non-logged in users) -->
    {% if not app.user %}
      <article class="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-8">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="font-bold text-blue-900 mb-1">Sign in to continue</h3>
            <p class="text-blue-700">Create an account or sign in to purchase tickets</p>
          </div>
          <div>
            {% include 'components/_register_button.html.twig' %}
          </div>
        </div>
      </article>
    {% endif %}
  </section>

  <!-- Order Summary Sidebar -->
  <section class="col-span-12 lg:col-span-5">
    <div class="sticky top-6">
      <!-- Event image - DESKTOP ONLY (hidden on mobile) -->
      {% if event.imgPath %}
        <article class="mb-6 hidden lg:block">
          <img 
            src="{{ asset(uploads_events ~ '/' ~ event.imgPath) }}" 
            alt="{{ event.name }}" 
            class="w-full h-48 object-cover rounded-xl shadow-md"
          >
        </article>
      {% endif %}

      <!-- Order summary -->
      <article class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
        <h3 class="text-xl font-bold text-gray-900 mb-6 pb-4 border-b">Order Summary</h3>
        
        <!-- Selected tickets -->
        <div id="selected-tickets" class="mb-4 space-y-3">
          <p class="text-gray-500 text-center py-4" id="empty-cart-message">
            No tickets selected
          </p>
        </div>
        
        <!-- Summary details -->
        <div class="space-y-3 pt-4 border-t border-gray-100">
          <div class="flex justify-between">
            <span class="text-gray-600">Subtotal</span>
            <span id="subtotal" class="font-medium">€0.00</span>
          </div>
          
          <div class="flex justify-between">
            <span class="text-gray-600">Service fee</span>
            <span id="service-fee" class="font-medium">€0.00</span>
          </div>
          
          <div class="flex justify-between pt-4 border-t border-gray-200">
            <span class="text-lg font-bold text-gray-900">Total</span>
            <span id="total" class="text-2xl font-bold text-gray-900">€0.00</span>
          </div>
        </div>
        
        <!-- Checkout button -->
        <button 
          id="checkout-btn"
          type="button"
          class="w-full mt-6 py-4 bg-gradient-to-r from-blue-600 to-blue-700 text-white 
            font-semibold rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all 
            transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed 
            disabled:hover:transform-none shadow-md hover:shadow-lg cursor-pointer"
          disabled
        >
          {% if app.user %}
            Proceed to Checkout
          {% else %}
            Sign in to Checkout
          {% endif %}
        </button>
        
        <!-- Secure payment notice -->
        <div class="mt-4 text-center">
          <div class="flex items-center justify-center text-gray-500 text-sm">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Secure payment · 100% guaranteed
          </div>
        </div>
      </article>
    </div>
  </section>
</div>

{% include 'event/js/ticket_selection.js.html.twig' %}
{% endblock %}