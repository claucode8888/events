{% extends 'layout.html.twig' %}

{% block title %}Selection ticket for {{ event.name }}{% endblock %}

{% block content %}
  <div class="grid grid-cols-12 gap-6 p-6 max-w-7xl mx-auto lg:px-6">
    <!-- Ticket categories -->
    <section class="col-span-12 lg:col-span-7">
      <!-- Event image - MOBILE ONLY (hidden on desktop) -->
      {% if event.imgPath %}
        <article class="mb-6 lg:hidden">
          {% include 'components/event/_img_event.html.twig' %}
        </article>
      {% endif %}
      
      <!-- Event header -->
      <article class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">{{ event.name | title }}</h1>
        <div class="flex items-center justify-center space-x-4 text-gray-600">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="font-medium">{{ event.startAt | date('l, F j, Y') }}</span>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium">{{ event.startAt | date('g:i A') }}</span>
          </div>
        </div>
      </article>

      <!-- Tickets selection -->
      <article class="mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Select Your Tickets</h2>
        
        <div class="space-y-4">
          {% for ticketCategory in event.ticketCategories %}
            <div class="
              {% if not app.user or ticketCategory.isSoldOut %}
              bg-gray-100
              {% else %}
              bg-white border border-gray-200 hover:border-blue-300
              {% endif %}
                rounded-xl p-6 transition-all duration-200 shadow-sm hover:shadow-md
              ">
              <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start mb-4">
                <div class="mb-3 lg:mb-0">
                  <h3 class="text-lg font-bold text-gray-900 mb-1">{{ ticketCategory.name | title }}</h3>

                  <!-- Availability badge (ticket category) -->
                  {% include 'components/event/_availability_badge.html.twig'
                      with {
                        'availability': ticketCategory.ticketsAvailability
                      }
                  %}
                  <!-- End Availability badge (ticket category) -->
                </div>

                <div class="lg:text-right">
                  <div class="text-2xl font-bold text-gray-900">
                    {% if ticketCategory.isFree %}
                      Gratis
                    {% else %}
                      {{ ticketCategory.price | format_currency('EUR') }}
                    {% endif %}
                  </div>
                  <p class="text-gray-500 text-sm mt-1">per ticket</p>
                </div>
              </div>
              
              <!-- Quantity selector -->
              <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <span class="text-gray-700 font-medium">Quantity</span>
                
                <div class="flex items-center space-x-3">
                  <button 
                    class="quantity-btn w-10 h-10 flex items-center justify-center bg-gray-100 text-gray-700 rounded-full hover:bg-gray-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    data-ticket-id="{{ ticketCategory.id }}"
                    data-action="decrease"
                    {% if not app.user or ticketCategory.isSoldOut %}
                      disabled
                    {% endif %}>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                    </svg>
                  </button>
                  <span id="quantity-{{ ticketCategory.id }}" class="text-lg font-bold text-gray-900 w-8 text-center">0</span>
                  <button
                    class="quantity-btn w-10 h-10 flex items-center justify-center bg-gray-100 text-gray-700 rounded-full hover:bg-gray-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    data-ticket-id="{{ ticketCategory.id }}"
                    data-action="increase"
                    {% if not app.user or ticketCategory.isSoldOut %}
                      disabled
                    {% endif %}>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {% else %}
            <div class="text-center py-8">
              <p class="text-gray-500">No tickets available for this event.</p>
            </div>
          {% endfor %}
        </div>
      </article>

      <!-- Register if not user logged in -->
      {% if not app.user %}
        <article class="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-8">
          <div class="flex flex-col justify-between">
            <div>
              <h4 class="font-bold text-blue-900 mb-1">Sign in required to continue</h4>
              <p class="text-blue-700 text-sm mb-3">You need an account to purchase tickets for this event</p>
            </div>
            <div class="flex gap-2">
              <div>
                <a
                  href="{{ path('app_login') }}"
                  class="inline-flex items-center justify-center rounded-md bg-blue-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
                >
                Log in
                </a>
              </div>
              <div>
                {% include 'components/_register_button.html.twig' %}
              </div>
            </div>
          </div>
        </article>
      {% endif %}
      <!-- End Register if not user logged in -->
    </section>

    {% include 'components/event/_ticket_selection_summary_order.html.twig' %}
  </div>

  {% include 'event/js/ticket_selection.js.html.twig' %}
{% endblock %}