{% extends 'layout.html.twig' %}

{% block title %}Event index{% endblock %}

{% block content %}
  <div class="flex flex-col gap-2">

    <!-- Events counter section -->
    {# <section class="m-2 p-16 bg-gray-100">
      <p>Images</p>
      {{ events | length }}
    </section>
    <!-- End Events counter section --> #}

    <!-- Events section -->
    <section class="mr-2 ml-2 py-6 px-6 lg:py-14 lg:px-28 bg-gray-100">

      {% if events | length > 0 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for event in events %}
            <!-- Card -->
            <article class="bg-white rounded-xl shadow-lg hover:shadow-xl transition flex flex-col h-full overflow-hidden">
              <!-- Header card -->
              <!-- Image -->
              <div class="relative overflow-hidden rounded-t-xl shadow-md">
                <img 
                  class="object-cover w-full h-56 transition-transform duration-500 hover:scale-105" 
                  src="{{ asset(uploads_events ~ '/' ~ event.imgPath) }}"
                  alt="{{ event.name }}"
                >
                <div class="absolute inset-0 bg-gradient-to-t from-black/40"></div>
              </div>
              <!-- End Image -->
              <!-- End Header card -->

              <div class="flex flex-col gap-1">
                <!-- Body card -->
                {% include 'components/event/_body_card.html.twig' %}
                <!-- End Body card -->

                <!-- Fotter card -->
                {% include 'components/event/_footer_card.html.twig' %}
                <!-- End Fotter card -->
              </div>
            </article>
            <!-- End Card -->
          {% endfor %}
        </div>
      {% else %}
        <article class="text-center">
          <p>There is not events shortly.</p>
        </article>
      {% endif %}
    </section>
    <!-- End Events section -->

  </div>
{% endblock %}