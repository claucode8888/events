{% extends 'layout.html.twig' %}

{% block title %}Event index{% endblock %}

{% block content %}
  <div class="flex flex-col gap-2">

    <!-- Events counter section -->
    {# <section class="m-2 p-16 bg-gray-100">
      <p>Images</p>
      {{ events | length }}
    </section>
    <!-- End Events counter section --> #}

    <!-- Events section -->
    <section class="mr-2 ml-2 py-6 px-6 lg:py-14 lg:px-28 bg-gray-100">

      {% if events | length > 0 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for event in events %} 
            <article class="bg-white rounded-xl shadow-lg hover:shadow-xl transition flex flex-col h-full overflow-hidden">

              <!-- Image -->
              <div class="relative overflow-hidden rounded-t-xl shadow-md">
                <img 
                  class="object-cover w-full h-72 transition-transform duration-500 hover:scale-105" 
                  src="{{ asset('uploads/events/calamaro.jpg.webp') }}" 
                  alt="{{ event.name }}"
                >
                <div class="absolute inset-0 bg-gradient-to-t from-black/40"></div>
              </div>
              <!-- End Image -->

              <div class="flex flex-col justify-between p-6 leading-normal h-full">

                <!-- Title -->
                <div class="mb-1 text-xl font-bold tracking-tight text-gray-900">
                  <h5>{{ event.name }}</h5>
                </div>
                <!-- End Title -->

                <!-- DateTime -->
                <div class="flex items-center text-sm text-gray-500 mb-3">
                  {{ event.startAt | date('M d, Y · H:i') }}
                </div>
                <!-- End DateTime -->

                <!-- Description -->
                <div class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-3">
                  <p>{{ event.description }}</p>
                </div>
                <!-- End Description -->

                <!-- Read More -->
                <div class="mt-auto">
                  <button
                    type="button"
                    class="
                      inline-flex items-center w-auto text-body bg-neutral-secondary-medium box-border border border-default-medium 
                      hover:bg-neutral-tertiary-medium hover:text-heading focus:ring-4 focus:ring-neutral-tertiary shadow-xs 
                      font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none
                    "
                  >
                    Read more
                    <svg
                      class="w-4 h-4 ms-1.5 rtl:rotate-180 -me-0.5"
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      fill="none"
                      viewBox="0 0 24 24"
                    >
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4"/>
                    </svg>
                  </button>
                </div>
                <!-- End Read More -->

              </div>

            </article>
          {% endfor %}
        </div>
      {% else %}
        <article class="text-center">
          <p>There is not events shortly.</p>
        </article>
      {% endif %}
    </section>
    <!-- End Events section -->

  </div>
{% endblock %}