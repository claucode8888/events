{% extends 'layout.html.twig' %}

{% block title %}Buy ticket for {{ event.name }}{% endblock %}

{% block content %}
<div class="grid grid-cols-12 gap-2 p-6">

  <!-- Ticket categories -->
  <section class="col-span-8 border-amber-600 border">
    <!-- Event name and date -->
    <article class="text-center">
      <div>
        <p class="font-semibold">{{ event.name }}</p>
      </div>
      <div>
        <p class="text-sm text-gray-400">Starts at {{ event.startAt | date('M d, Y · H:i') }}</p>
      </div>
    </article>
    <!-- End Event name and date -->
    <hr class="m-2 text-gray-100">
    <!-- Tickets selection -->
    <article class="col-span-autoborder border-amber-100">
      {% for TC in event.ticketCategories %}
        <div class="border border-amber-100">
          <div>{{ TC.name }}</div>
          <div>{{ TC.price }}</div>
        </div>
      {% endfor %}
    </article>
    <!-- End Tickets selection -->
    <hr class="m-2 text-gray-100">
    <!-- Register button -->
    {% if not app.user %}
    <article class="flex justify-end items-end">
      <div class="mr-8">
        {% include 'components/_register_button.html.twig' %}
      </div>
    </article>
    {% endif %}
    <!-- End Register button -->
  </section>
  <!-- End Ticket categories -->
  
  <!-- Sidebar buy ticket-->
  <section class="col-span-4 border-amber-600 border">
    <div class="grid grid-cols-1 gap-2">
      {% if event.imgPath %}
        <article>
          <img src="{{ asset(uploads_events ~ '/' ~ event.imgPath) }}" alt="{{ event.name }}" class="w-auto h-auto">
        </article>
      {% endif %}
      <article class="grid grid-cols-1 gap-2 lg:text-lg md:text-md sm:text-sm xs:text-xs lg:p-6 md:p-6 sm:p-4 xs:p-4">
        <div class="font-semibold">Shopping resume</div>
        <div class="font-semibold">Toltal</div>
      </article>
    </div>
  </section>
  <!-- End Sidebar buy ticket-->
  </div>
{% endblock %}